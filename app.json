{
  "expo": {
    "name": "StockYa",
    "slug": "stockya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "emprendegest",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.emprendegest.mobile",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.emprendegest.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F7F1E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F1E6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "StockYa necesita acceso a tus fotos para agregar imágenes a tus productos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "root": "app"
      },
      "eas": {
        "projectId": "eddd4394-b2c4-4060-a500-6baa1b531a70"
      }
    },
    "owner": "camilabuenor"
  }
}
